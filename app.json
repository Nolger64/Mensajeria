{
  "expo": {
    "name": "Aura Spa",
    "slug": "videos",
    "scheme": "auraspa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FHS necesita acceso a tu ubicación para el mapa y servicios de entrega.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FHS necesita tu ubicación para monitorear entregas en tiempo real.",
        "NSBluetoothAlwaysUsageDescription": "FHS utiliza Bluetooth para accesorios y terminales de cobro."
      }
    },
    "android": {
      "package": "com.auraspa.app",
      "adaptiveIcon": {
        "backgroundColor": "#454D46",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FHS necesita tu ubicación para el mapa y navegación."
        }
      ],
      "expo-router",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c6db365-97be-4efd-8759-2fe8b3ad283c"
      }
    }
  }
}
